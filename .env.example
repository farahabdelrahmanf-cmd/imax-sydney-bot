# IMAX Sydney Bot Configuration

# ntfy.sh topic for phone push notifications (e.g. imax-sydney-odyssey-YOURNAME)
# Install the "ntfy" app on iOS/Android and subscribe to this exact topic name!
NTFY_TOPIC=imax-sydney-odyssey-alerts

# Guest Details for Auto-fill (so seats don't expire on the details page)
GUEST_FIRST_NAME=Farah
GUEST_LAST_NAME=Farah
GUEST_EMAIL=your_email@example.com
GUEST_PHONE=0400000000

# Target Movie and Cinema
CINEMA_URL=https://www.eventcinemas.com.au/cinema/imax-sydney
TARGET_MOVIE_TITLE=The Odyssey

# Session preferences
# Days of week: 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
TARGET_DAYS_OF_WEEK=5,6,0
# Earliest session time (24hr format, e.g. 17:00 for 5 PM)
EARLIEST_TIME=17:00

# Monitoring Interval (in seconds)
CHECK_INTERVAL_SECONDS=60
# Random jitter to prevent bot patterns (+/- seconds)
CHECK_JITTER_SECONDS=20

# Run in headless mode during monitoring (will automatically pop open visible window when seats are secured!)
HEADLESS=true
